# Backend local/development configuration; use only synthetic demo data.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://spacedrift:change-me@localhost:5432/spacedrift

# Briefcase iOS Supabase project (free tier). Before using this block, set the
# database password locally from Supabase > Project Settings > Database.
# Never commit backend/.env or put a database password in the iOS app.
# The direct database endpoint may require IPv6; use Supabase's session
# pooler connection string if the backend host is IPv4-only.
# DATABASE_URL=postgresql+psycopg://postgres:<URL-ENCODED-PASSWORD>@db.vetivgesigevfcolqpca.supabase.co:5432/postgres
# OIDC_ISSUER=https://vetivgesigevfcolqpca.supabase.co/auth/v1
# OIDC_AUDIENCE=authenticated
# OIDC_JWKS_URL=https://vetivgesigevfcolqpca.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Auth/Storage project URL; file endpoints still need implementation.
# SUPABASE_URL=https://vetivgesigevfcolqpca.supabase.co
# SUPABASE_STORAGE_BUCKET=deliverables

# iOS API base URL is configured in ios/SpacedriftApp/SpacedriftApp-Info.plist.
# Use 127.0.0.1 for Simulator; use a Mac-reachable hostname or HTTPS URL for iPhone.
